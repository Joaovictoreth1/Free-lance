{
  "name": "tecsafe-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production static storefront and lead-generation web application for Tecsafe Segurança Eletrônica.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "validate:html": "html-validate index.html dist/index.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run validate:html"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.15.0",
    "globals": "^16.0.0",
    "html-validate": "^11.22.1",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}

{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "require-sri": "off",
    "tel-non-breaking": "off",
    "valid-id": "error",
    "no-dup-id": "error",
    "no-dup-attr": "error",
    "no-unknown-elements": "error",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h36": "error",
    "wcag/h37": "error",
    "wcag/h67": "error",
    "wcag/h71": "error",
    "heading-level": "error"
  }
}
